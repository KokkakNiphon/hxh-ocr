# Text files are stored and checked out with LF (shell scripts break with CRLF).
* text=auto eol=lf
*.ps1 text eol=crlf

# Binary artifacts: never touch line endings or diff them as text.
*.pgm binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wasm binary
*.hxhm binary
*.espdl binary
*.bin binary
*.npy binary
*.pt binary
*.onnx binary
