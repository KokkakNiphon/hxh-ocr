# datasets, including the scraped real images and reference charts (copyrighted, local only)
/data/

# training runs, exports, environments, downloads
runs/
exports/
.venv/
.venv-*/
.wheels/
__pycache__/
*.pyc
*.log

# Rust build output
target/

# regenerable experiment outputs (simulated logits, golden vectors, weight dumps, intermediate ONNX)
experiments/**/*.npy
experiments/**/golden.bin
experiments/**/*.info
experiments/**/*.onnx

# web demo test data (generated by web/test/make_reference.py)
web/test/out/

# previews built from scraped (copyrighted) images
previews/real_*

# the video storyboard's PDF export embeds anime frames from data/real (the .pen only links to them)
docs/video/storyboard.pdf

# local tool settings
.claude/settings.local.json

experiments/det_engine/models/

# Cloudflare deployment build output and tooling
site/dist/
site/node_modules/
site/.cloudflare/
.env
.env.local
experiments/**/*.npz

# public release staging (scripts/export_public.py, scripts/hf_package_*.py)
release/

# openly licensed fonts for the generator (scripts/fetch_fonts.py; hashes in rust/hxh-synth/fonts.lock.json)
/fonts/

# private evaluation outputs (not published)
experiments/family/eval/photos_*
# the det_v2 + tiny readers comparison is assembled by scripts/launch_family.sh eval from committed files
experiments/family/v2tiny/
experiments/family/eval/*.err
translator/node_modules/
translator/test/out/
translator/site/dist/
translator/site/node_modules/
translator/site/.cloudflare/
# renders of the dropped Blender model (blender/beetle07.py makes them again)
translator/blender/out*/
# the sounds one by one (earshot remakes them from translator/tools/sfx.json); the app plays the sprite
translator/assets/sfx/*
!translator/assets/sfx/sprite.webm
!translator/assets/sfx/sprite.mp3
!translator/assets/sfx/sprite.json
!translator/assets/sfx/manifest.json
